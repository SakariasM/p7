  "info": {
    "description": "Vessel positions, tracks and snapshots from AIS data. All timestamps are UTC; naive timestamps are interpreted as UTC.",
    "title": "AIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/snapshot": {
      "get": {
        "operationId": "snapshot_snapshot_get",
        "parameters": [
          {
            "description": "Snapshot time (UTC)",
            "in": "query",
            "name": "at",
            "required": true,
            "schema": {
              "description": "Snapshot time (UTC)",
              "format": "date-time",
              "title": "At",
              "type": "string"
            }
          },
          {
            "description": "Include vessels seen this recently",
            "in": "query",
            "name": "lookback_min",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Include vessels seen this recently",
              "maximum": 60,
              "minimum": 1,
              "title": "Lookback Min",
              "type": "integer"
            }
          },
          {
            "description": "min_lon,min_lat,max_lon,max_lat (WGS84), e.g. 7.5,54.5,15.5,58",
            "in": "query",
            "name": "bbox",
            "required": true,
            "schema": {
              "description": "min_lon,min_lat,max_lon,max_lat (WGS84), e.g. 7.5,54.5,15.5,58",
              "title": "Bbox",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Snapshot",
        "tags": [
          "map"
        ]
      }
    },
    "/stops": {
      "get": {
        "operationId": "stops_stops_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Start",
