    "/vessels": {
      "get": {
        "operationId": "search_vessels_vessels_get",
        "parameters": [
          {
            "description": "MMSI prefix, name or callsign",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "MMSI prefix, name or callsign",
              "maxLength": 100,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VesselSummary"
                  },
