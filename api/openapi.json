              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Vessels",
        "tags": [
          "vessels"
        ]
      }
    },
    "/vessels/{mmsi}": {
      "get": {
        "operationId": "vessel_vessels__mmsi__get",
        "parameters": [
          {
            "in": "path",
            "name": "mmsi",
            "required": true,
            "schema": {
              "maximum": 799999999,
              "minimum": 200000000,
              "title": "Mmsi",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
