              "type": "string"
            }
          },
          {
            "description": "min_lon,min_lat,max_lon,max_lat (WGS84), e.g. 7.5,54.5,15.5,58",
            "in": "query",
            "name": "bbox",
            "required": true,
            "schema": {
              "description": "min_lon,min_lat,max_lon,max_lat (WGS84), e.g. 7.5,54.5,15.5,58",
              "title": "Bbox",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Stop"
                  },
                  "title": "Response Stops Stops Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "description": "Not implemented yet (Phase 2)"
          }
        },
        "summary": "Stops",
        "tags": [
          "trajectories"
        ]
      }
    },
