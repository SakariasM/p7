                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Vessel",
        "tags": [
          "vessels"
        ]
      }
    },
    "/vessels/{mmsi}/track": {
      "get": {
        "operationId": "track_vessels__mmsi__track_get",
        "parameters": [
          {
            "in": "path",
            "name": "mmsi",
            "required": true,
            "schema": {
